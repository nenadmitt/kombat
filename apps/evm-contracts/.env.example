# Copy to .env (gitignored) and fill in before running scripts that deploy or
# verify contracts. Never commit real keys.

# Deployer key (use a throwaway/dev key for testnets; a hardware/relayer
# signer for anything real - never a raw mainnet key in a local .env).
PRIVATE_KEY=

# RPC endpoints (referenced by foundry.toml's [rpc_endpoints])
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Verification (referenced by foundry.toml's [etherscan])
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Script inputs. FAUCET_ADDRESS is required by DeployKombatCoin.s.sol;
# KOMBAT_ADDRESS / USDC_ADDRESS override DeployStakePot.s.sol's Sepolia defaults.
FAUCET_ADDRESS=
# KOMBAT_ADDRESS=
# USDC_ADDRESS=
