# Copy to `.env` and fill in. react-native-config bundles these into the app,
# so keep this file CLIENT-SAFE - never add secrets here.

# localhost resolves to the host Mac from the iOS Simulator; use your machine's
# LAN IP instead when testing on a physical device or Android emulator (10.0.2.2).
API_BASE_URL=http://localhost:3000

# Required. Alchemy API key for the RPC endpoints the wallet reads chain state through.
ALCHEMY_TOKEN=

# Optional. Status/incident page opened by the maintenance banner's Details
# button; the button is hidden when this is unset.
MAINTENANCE_DETAILS_URL=https://status.example.com

# Optional. Expected StakePot contract address; deposits refuse a
# server-supplied target that differs. Unset skips the check (dev).
STAKE_POT_ADDRESS_PIN=
