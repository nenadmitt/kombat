# Copy to `.env` and fill in. react-native-config bundles these into the app,
# so keep this file CLIENT-SAFE — never add PRIVY_APP_SECRET or other secrets here.
# Values come from the Privy Dashboard (https://dashboard.privy.io).

# Your Privy App ID (public).
PRIVY_APP_ID=

# Your Privy App Client ID for this mobile client (public).
# Create an app client under your app's settings to get this.
PRIVY_CLIENT_ID=
