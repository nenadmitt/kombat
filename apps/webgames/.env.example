# Platform API. Defaults to production when unset.
VITE_API_URL=http://localhost:3000

# Chain the stake pot is deployed on (Sepolia by default).
VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# Optional. Without it the WalletConnect option is dead but injected
# wallets (MetaMask, Rabby) still work.
VITE_WALLETCONNECT_PROJECT_ID=
