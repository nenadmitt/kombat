# Server
PORT=3000

# Postgres (matches docker-compose.yaml for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gaming_platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Optional — unset means the in-memory cache store (single-instance only).
# Local dev with docker-compose: redis://localhost:6380
# REDIS_URL=

# openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Optional — unset means EmailService logs tokens instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=login@gaming-platform.local

# Staking / chain — optional as a group: leave unset to disable staked games
# (free games unaffected). Addresses: apps/evm-contracts/README.md.
# CHAIN_RPC_URL=
# CHAIN_ID=11155111
# ESCROW_ADDRESS=0x2D3C6e3b41365B2b221982B5fAc5F496746160f2
# KOMBAT_ADDRESS=0xFE25C2b2400144c6536b9F707F06b751D6eeF943
# USDC_ADDRESS=0x277c9f3957633C99ef8F7421B980B50C41b31a7b
# The escrow operator hot key (pays permit-path gas — keep it topped up).
# OPERATOR_PRIVATE_KEY=
# CHAIN_CONFIRMATIONS=1
# Max stake per player, in human units (min is per-asset, hardcoded in core).
# STAKE_MAX=1000
