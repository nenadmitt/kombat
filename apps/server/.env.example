# Server
PORT=3000

# Postgres (matches docker-compose.yaml for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gaming_platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Optional — unset means the in-memory cache store (single-instance only).
# Local dev with docker-compose: redis://localhost:6380
# REDIS_URL=

# openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Optional — unset means EmailService logs tokens instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=login@gaming-platform.local

# Optional — the operator/admin surface (/api/v1/admin/*). Unset means every
# admin request is rejected. Send it as the `x-admin-token` header.
ADMIN_TOKEN=

# Optional — App Review demo login. Set DEMO_LOGIN_CODE (exactly 8 chars) to
# let the demo email log in with that fixed code, skipping the email OTP. Off
# unless the code is set. DEMO_LOGIN_EMAIL defaults to demo@playkombat.xyz.
# DEMO_LOGIN_EMAIL=demo@playkombat.xyz
# DEMO_LOGIN_CODE=00000000

# Staking / chain — optional as a group: leave unset to disable staked games
# (free games unaffected). Token addresses are NOT env — they live in
# src/chain/token-registry.ts, keyed by CHAIN_ID.
# CHAIN_RPC_URL=
# CHAIN_ID=11155111
# The platform hot key: signs pot withdrawals and gas top-ups. Keep it funded.
# OPERATOR_PRIVATE_KEY=
# CHAIN_CONFIRMATIONS=1
# Max stake per player, in human units (min is per-asset, hardcoded in core).
# STAKE_MAX=1000

# Stake pot (pooled staking). Players deposit into the StakePot contract once
# and every staked match after that settles in the server ledger — no per-match
# transactions. Unset means staked games are unavailable.
# STAKE_POT_ADDRESS=
# Block the pot was deployed in (printed by DeployStakePot.s.sol). Without it a
# fresh cursor starts at the current head and earlier deposits are NOT credited.
# STAKE_POT_DEPLOY_BLOCK=
# Platform fee on a settled match, in bps. Capped at 1000 (10%).
# STAKE_FEE_BPS=500
# STAKE_POT_POLL_MS=5000
# STAKE_POT_RECONCILE_MS=600000
# Signup grant: FAUCET_KEY is a hot wallet holding a KOMBAT float and nothing
# else, so a leak costs a top-up rather than the pot. 0 disables the grant.
# FAUCET_KEY=
# FAUCET_GRANT_KOMBAT=1000
