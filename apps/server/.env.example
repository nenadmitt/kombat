# Server
PORT=3000

# Postgres (matches docker-compose.yaml for local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gaming_platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Optional — unset means EmailService logs tokens instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=login@gaming-platform.local
