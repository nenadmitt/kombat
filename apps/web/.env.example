# Postgres. Either DATABASE_URL, or the discrete POSTGRES_* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kombat_web
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=kombat_web
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Managed Postgres usually needs this (encrypted link, no CA verification).
POSTGRES_SSL=false

# Unlocks /admin. Minimum 10 characters, or the admin surface stays shut.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Stake pot (client-side: these ship to the browser).
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_STAKE_POT_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# NestJS platform API (user lookup for transfers)
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3000/api/v1
# Mainnet RPC the stake form resolves ENS names against - optional
NEXT_PUBLIC_ENS_RPC_URL=
# WalletConnect Cloud project id - optional; injected wallets work without it
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Webgames demo app the hero button links to
NEXT_PUBLIC_DEMO_APP_URL=https://demo.playkombat.xyz
