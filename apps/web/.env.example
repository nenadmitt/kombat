# Postgres. Either DATABASE_URL, or the discrete POSTGRES_* vars below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kombat_web
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=kombat_web
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Managed Postgres usually needs this (encrypted link, no CA verification).
POSTGRES_SSL=false

# Unlocks /admin. Minimum 10 characters, or the admin surface stays shut.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
