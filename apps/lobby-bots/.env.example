BOTS_SERVER_URL=http://localhost:3000
BOTS_COUNT=10

# Must match the server's BOT_SECRET. The only credential the runner holds,
# and it reaches is_bot accounts only.
BOTS_SECRET=

BOTS_JOIN_DELAY_MS_MIN=20000
BOTS_JOIN_DELAY_MS_MAX=30000
BOTS_MIN_OPEN_ROOMS=4
BOTS_MAX_HOSTED_ROOMS=4
# BOTS_MAX_ROOMS_PER_GAME=2
BOTS_GAME_MIX=NavalBattle:0.3,Ludo:0.3,TripleCut:0.2,Salvo:0.2

BOTS_STAKES_ENABLED=true
# Comma-separated StakeAsset names (Native is never stakeable).
# BOTS_STAKE_ASSETS=Kombat
BOTS_LOG_LEVEL=info

# Optional tuning, defaults shown. Ranges are in ms, as a _MIN/_MAX pair.
# BOTS_SEAT_FILL_FIRST_MS_MIN=5000
# BOTS_SEAT_FILL_FIRST_MS_MAX=10000
# BOTS_SEAT_FILL_NEXT_MS_MIN=15000
# BOTS_SEAT_FILL_NEXT_MS_MAX=20000
# BOTS_EARLY_START_CHANCE=0.5
# BOTS_EARLY_START_MS_MIN=20000
# BOTS_EARLY_START_MS_MAX=45000
# BOTS_CONCEDE_DELAY_MS_MIN=5000
# BOTS_CONCEDE_DELAY_MS_MAX=15000
# BOTS_HOSTED_ROOM_TTL_MS_MIN=180000
# BOTS_HOSTED_ROOM_TTL_MS_MAX=480000
# BOTS_BSHIP_SETUP_MS_MIN=5000
# BOTS_BSHIP_SETUP_MS_MAX=15000
# BOTS_BSHIP_SHOT_MS_MIN=2500
# BOTS_BSHIP_SHOT_MS_MAX=6000
# BOTS_LUDO_ROLL_MS_MIN=1300
# BOTS_LUDO_ROLL_MS_MAX=3000
# BOTS_LUDO_MOVE_MS_MIN=900
# BOTS_LUDO_MOVE_MS_MAX=2500
# BOTS_RPS_LOCK_MS_MIN=1500
# BOTS_RPS_LOCK_MS_MAX=5000
# BOTS_SALVO_SHOT_MS_MIN=3000
# BOTS_SALVO_SHOT_MS_MAX=8000
