BOTS_SERVER_URL=http://localhost:3000
BOTS_COUNT=10

# Provisioning only: the server's ADMIN_TOKEN, used to mark accounts is_bot.
BOTS_ADMIN_TOKEN=

# test-otp works only on a server with the test login route (never production).
BOTS_AUTH_MODE=test-otp

BOTS_JOIN_DELAY_MS_MIN=20000
BOTS_JOIN_DELAY_MS_MAX=30000
BOTS_MIN_OPEN_ROOMS=4
BOTS_MAX_HOSTED_ROOMS=4
BOTS_GAME_MIX=NavalBattle:0.6,Ludo:0.4

BOTS_STAKES_ENABLED=true
BOTS_LOG_LEVEL=info
