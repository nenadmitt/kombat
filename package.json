{
  "name": "gaming-platform",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "mobile": "npm run start --workspace @gaming-platform/mobile",
    "web": "npm run dev --workspace @gaming-platform/web",
    "webgames": "npm run dev --workspace @gaming-platform/webgames",
    "bots": "npm run dev --workspace @gaming-platform/lobby-bots",
    "mobile:ios": "npm run ios --workspace @gaming-platform/mobile",
    "mobile:android": "npm run android --workspace @gaming-platform/mobile",
    "server": "npm run start:dev --workspace @gaming-platform/server",
    "server:migration:generate": "npm run migration:generate --workspace @gaming-platform/server --",
    "server:migration:run": "npm run migration:run --workspace @gaming-platform/server"
  },
  "devDependencies": {
    "turbo": "^2.10.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "npm@11.7.0"
}
